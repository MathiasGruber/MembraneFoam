#!/bin/sh
# Build only the maintained laminar solvers and membrane library.
set -eu
cd "$(dirname "$0")"
: "${WM_PROJECT_DIR:?Source OpenFOAM v2606 etc/bashrc before building}"
command -v wmake >/dev/null
wmake libso src/boundaryConditions
for solver in pisoSaltTransport potentialSalt simpleSaltTransport simpleSaltDiffusion; do
    wmake "src/solvers/$solver"
done
